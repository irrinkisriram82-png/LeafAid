# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml.

# Google AI Studio -> https://aistudio.google.com -> Get API key
GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: override the default model if your key lists a different ID
# GEMINI_MODEL = "gemini-3.5-flash"

# Gmail account that SENDS the emails.
# Enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (never use your real password).
GMAIL_ADDRESS = "your-sending-gmail@gmail.com"
GMAIL_APP_PASSWORD = "your-16-char-app-password"
